---

---

<section id="contact" class="py-24 lg:py-32 section-dark border-t border-[var(--color-ink)]">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Left — info -->
      <div class="lg:col-span-5">
        <div class="eyebrow">Get in touch</div>
        <h2 class="text-4xl lg:text-5xl mb-6">
          Send up a <em>signal.</em>
        </h2>
        <p class="text-[var(--color-ink-inverse)]/70 leading-relaxed mb-10 text-lg">
          Whether you need a fresh build, a rebuild, or someone to take an
          existing site off your hands — drop me a line and I'll come back
          with an honest assessment. No pressure, no jargon.
        </p>

        <!-- Direct email -->
        <div class="mb-8">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-inverse)]/50 mb-2">
            Or email directly
          </p>
          <a
            href="mailto:hello@rjp.digital"
            class="text-xl text-[var(--color-ink-inverse)] hover:text-[var(--color-amber)] transition-colors duration-150 underline-offset-4 hover:underline"
          >
            hello@rjp.digital
          </a>
        </div>

        <!-- Helpful to include -->
        <div class="pt-8 border-t border-white/10">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-inverse)]/50 mb-4">
            Helpful to include
          </p>
          <ul class="space-y-2.5">
            {[
              'Link to your current site',
              'What you want to achieve',
              "What's frustrating you most",
            ].map((item) => (
              <li class="flex items-start gap-3 text-[var(--color-ink-inverse)]/80">
                <span
                  class="flex-shrink-0 w-4 h-4 mt-1 rounded-full border border-[var(--color-amber)] flex items-center justify-center"
                  aria-hidden="true"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-amber)]"></span>
                </span>
                <span class="text-[15px]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right — form -->
      <div class="lg:col-span-7">
        <div class="bg-[#152a44] border border-white/10 rounded-2xl p-7 lg:p-9">
          <form
            id="contact-form"
            name="contact"
            method="POST"
            action="/api/contact"
            class="space-y-5"
          >
            <!-- Honeypot -->
            <p class="hidden" aria-hidden="true">
              <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div>
              <label for="name" class="block text-xs font-mono uppercase tracking-widest text-[var(--color-ink-inverse)]/60 mb-2">
                Name
              </label>
              <input
                type="text" id="name" name="name" required
                placeholder="Your name"
                class="w-full px-4 py-3 bg-[#0b2540] border border-white/15 rounded-lg text-[var(--color-ink-inverse)] placeholder:text-white/40 focus:outline-none focus:border-[var(--color-amber)] transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-mono uppercase tracking-widest text-[var(--color-ink-inverse)]/60 mb-2">
                Email
              </label>
              <input
                type="email" id="email" name="email" required
                placeholder="you@example.com"
                class="w-full px-4 py-3 bg-[#0b2540] border border-white/15 rounded-lg text-[var(--color-ink-inverse)] placeholder:text-white/40 focus:outline-none focus:border-[var(--color-amber)] transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-mono uppercase tracking-widest text-[var(--color-ink-inverse)]/60 mb-2">
                Message
              </label>
              <textarea
                id="message" name="message" rows="6" required
                placeholder="Tell me about your project — what's not working, what you'd like instead, any timing in mind."
                class="w-full px-4 py-3 bg-[#0b2540] border border-white/15 rounded-lg text-[var(--color-ink-inverse)] placeholder:text-white/40 focus:outline-none focus:border-[var(--color-amber)] transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Status message -->
            <div id="form-status" class="hidden" role="alert"></div>

            <button
              type="submit"
              id="submit-button"
              class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-amber)] hover:bg-[var(--color-amber-hover)] text-[var(--color-ink)] font-semibold rounded-full transition-colors duration-150 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="button-text">Send message</span>
              <span id="button-loading" class="hidden">Sending…</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const buttonText = document.getElementById('button-text') as HTMLSpanElement;
  const buttonLoading = document.getElementById('button-loading') as HTMLSpanElement;
  const formStatus = document.getElementById('form-status') as HTMLDivElement;

  function setLoading(loading: boolean) {
    submitButton.disabled = loading;
    buttonText.classList.toggle('hidden', loading);
    buttonLoading.classList.toggle('hidden', !loading);
  }

  function showStatus(message: string, isError: boolean) {
    formStatus.textContent = message;
    formStatus.className = '';
    formStatus.classList.add(
      'p-4', 'rounded-lg', 'text-sm', 'font-medium', 'border',
      isError
        ? 'border-red-400/30 bg-red-500/10 text-red-200'
        : 'border-emerald-400/30 bg-emerald-500/10 text-emerald-200'
    );
  }

  function hideStatus() {
    formStatus.className = 'hidden';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideStatus();
    setLoading(true);

    try {
      const formData = new FormData(form);
      const response = await fetch('/api/contact', { method: 'POST', body: formData });
      const result = await response.json();

      if (response.ok && result.success) {
        showStatus("Message sent — I'll be in touch within 24 hours.", false);
        form.reset();
      } else {
        showStatus(result.error || 'Something went wrong. Please try again.', true);
      }
    } catch {
      showStatus('Failed to send. Please check your connection and try again.', true);
    } finally {
      setLoading(false);
    }
  });
</script>

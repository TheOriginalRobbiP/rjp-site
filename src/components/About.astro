---

---

<section id="about" class="py-24 lg:py-32 section-base border-t border-[var(--color-border-light)]">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="grid md:grid-cols-6 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Left — section heading + mascot -->
      <div class="md:col-span-2 lg:col-span-5">
        <div class="eyebrow">About</div>
        <h2 class="text-4xl lg:text-5xl mb-6">
          Design & Dev<br/>
          on tap —<br/>
          <em>when you need it.</em>
        </h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
          No messy hiring processes. No unpredictable freelance bills.
          Just a senior developer on retainer, producing high-end results.
        </p>

        <!-- Availability -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-full border border-[var(--color-border)] bg-[var(--color-canvas-raised)] mb-8">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-muted)]">2 spots available</span>
        </div>

        <!-- How it works -->
        <div class="space-y-4">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-subtle)]">How it works</p>
          {[
            { n: '01', label: 'Subscribe & get your board' },
            { n: '02', label: 'Add infinite requests' },
            { n: '03', label: 'Get updates every 48 hrs' },
            { n: '04', label: 'Pause when not needed' },
          ].map((step) => (
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-[var(--color-ink-subtle)] w-5 flex-shrink-0">{step.n}</span>
              <span class="text-sm text-[var(--color-ink-muted)]">{step.label}</span>
            </div>
          ))}
        </div>


      </div>

      <!-- Right — body copy + stats -->
      <div class="md:col-span-4 lg:col-span-7">
        <div class="space-y-5 text-[var(--color-ink-muted)] leading-relaxed text-[17px]">
          <p>
            I'm <strong class="text-[var(--color-ink)]">Robin</strong> — a senior web developer who
            builds careful, fast, hand-coded websites for startups and small businesses on
            <strong class="text-[var(--color-ink)]">Astro.js</strong>, the modern framework built for
            content-first sites. New builds, rebuilds, and the long-term care of both.
          </p>
          <p>
            Agencies are bloated, slow, and expensive. Hiring a full-time senior developer
            takes months and costs R600k+ a year in salary and benefits. And dealing with
            typical freelancers is a lottery.
          </p>
          <p>
            That's why I created rjp.digital as a productized service. You get the quality
            and reliability of a senior full-stack developer, but you only pay for exactly
            what you use.
          </p>
        </div>

        <!-- Stats row -->
        <div class="mt-12 pt-8 border-t border-[var(--color-border)] grid grid-cols-3 gap-6">
          {[
            { value: '6+',   label: 'Years experience' },
            { value: '50+',  label: 'Sites delivered' },
            { value: '100%', label: 'Owner-operated' },
          ].map((stat) => (
            <div>
              <p class="font-display text-4xl lg:text-5xl text-[var(--color-accent)]">{stat.value}</p>
              <p class="text-xs uppercase tracking-widest text-[var(--color-ink-subtle)] mt-2 font-mono">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>

    </div>


  </div>
</section>
